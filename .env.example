# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# For the scheduled GitHub Actions run these same names go in the repository's
# Actions secrets instead (see the README). Nothing here is read from a file at
# runtime; every value reaches the code as an environment variable.

# ---- Required ----
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=your-key-here

# ---- Optional: broad fallback coverage across all employers ----
# Free tier (250 calls/day) at developer.adzuna.com
# Leave blank to skip Adzuna entirely.
ADZUNA_APP_ID=your-app-id-here
ADZUNA_APP_KEY=your-app-key-here

# ---- Optional: U.S. federal jobs (NIH, FDA, CDC, VA) ----
# Free key at developer.usajobs.gov
# USAJOBS_EMAIL is not a login. Their API requires a contact address in the
# User-Agent header, so whatever you put here is sent to data.usajobs.gov with
# every request. Use an address you are willing to disclose.
# Leave blank to skip USAJOBS entirely.
USAJOBS_EMAIL=you@example.com
USAJOBS_KEY=your-key-here
